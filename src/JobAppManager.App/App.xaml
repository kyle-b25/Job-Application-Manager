<Application x:Class="JobAppManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JobAppManager.App.ViewModels"
             xmlns:views="clr-namespace:JobAppManager.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Order matters: each dictionary uses keys from the ones above it. -->
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Text.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
                <ResourceDictionary Source="Styles/Cards.xaml" />
                <ResourceDictionary Source="Styles/StatusBadge.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel-first navigation: the shell binds a ContentControl to whichever page
                 ViewModel is current, and these pick the View. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}">
                <views:ApplicationsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ApplicationEditorViewModel}">
                <views:ApplicationEditorView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
