<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The single source of colour for the whole app. Nothing else in /Styles or /Views should
         contain a literal hex value; if a new shade is needed it gets a name here first. -->

    <!-- Surfaces, darkest to lightest. Window > sidebar > card > raised control. -->
    <Color x:Key="SurfaceWindowColor">#0F1116</Color>
    <Color x:Key="SurfaceSidebarColor">#14171E</Color>
    <Color x:Key="SurfaceCardColor">#1A1D24</Color>
    <Color x:Key="SurfaceRaisedColor">#232730</Color>
    <Color x:Key="SurfaceHoverColor">#2B303B</Color>

    <SolidColorBrush x:Key="SurfaceWindowBrush" Color="{StaticResource SurfaceWindowColor}" />
    <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="{StaticResource SurfaceSidebarColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />

    <!-- Borders. Hairline separates cards from the page; strong marks a focused input. -->
    <SolidColorBrush x:Key="BorderHairlineBrush" Color="#282D38" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A404E" />

    <!-- Text. Muted is for labels and secondary metadata, faint for placeholders. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E8EC" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8B909B" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#5C6270" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#08130E" />

    <!-- The green accent and its interaction states. -->
    <Color x:Key="AccentColor">#3ECF8E</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4FE0A0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2FB579" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="#1F3B31" />

    <SolidColorBrush x:Key="DangerBrush" Color="#E05561" />
    <SolidColorBrush x:Key="DangerDimBrush" Color="#3B2226" />

    <!-- Status palette. Cool-to-green as an application progresses, muted red for rejection,
         grey for the two stages that mean "not in play". Each stage gets a saturated foreground
         and a dim background so a badge reads at a glance without shouting. -->
    <SolidColorBrush x:Key="StatusAppliedBrush" Color="#6C8CD5" />
    <SolidColorBrush x:Key="StatusAppliedDimBrush" Color="#1E2739" />
    <SolidColorBrush x:Key="StatusInterviewBrush" Color="#3ECF8E" />
    <SolidColorBrush x:Key="StatusInterviewDimBrush" Color="#12332A" />
    <SolidColorBrush x:Key="StatusRejectedBrush" Color="#E05561" />
    <SolidColorBrush x:Key="StatusRejectedDimBrush" Color="#33191D" />

    <!-- Interest level: the SRS red/yellow/green. -->
    <SolidColorBrush x:Key="InterestRedBrush" Color="#E05561" />
    <SolidColorBrush x:Key="InterestYellowBrush" Color="#E0B341" />
    <SolidColorBrush x:Key="InterestGreenBrush" Color="#3ECF8E" />

    <!-- Chart series, in the order a categorical chart should consume them. -->
    <SolidColorBrush x:Key="ChartGridBrush" Color="#242934" />

</ResourceDictionary>
