<Project>

  <!-- Product and version metadata for every project in the repo. The installer reads AppVersion
       out of this file (build\build-installer.ps1 parses it) so the exe's file version and the
       version shown in Add/Remove Programs can never drift apart. Bump <Version> here and
       nowhere else. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>Job Application Manager</Product>
    <Company>Kyle Basirico</Company>
    <Copyright>Copyright (c) 2026 Kyle Basirico</Copyright>
  </PropertyGroup>

</Project>
